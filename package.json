{
  "name": "@uplab/vendure-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Uplab's pack of Vendure plugins for the Ukrainian market",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uplab/uplab-vendure-plugins.git"
  },
  "homepage": "https://github.com/Uplab/uplab-vendure-plugins#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.28.8",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "check:packages": "node scripts/check-packages.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter dev-server dev",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && node scripts/release.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^22.20.1",
    "@vendure/core": "3.8.0",
    "@vendure/testing": "3.8.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "knip": "^6.40.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "rimraf": "^6.0.1",
    "sql.js": "1.15.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.11"
  }
}
