{
  "name": "@uplab/vendure-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Uplab's pack of Vendure plugins for the Ukrainian market",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uplab/vendure-plugins.git"
  },
  "homepage": "https://github.com/Uplab/vendure-plugins#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter dev-server dev",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@swc/core": "^1.14.1",
    "@types/node": "^22.15.3",
    "@vendure/core": "3.7.2",
    "@vendure/testing": "3.7.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "sql.js": "1.10.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.4",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
