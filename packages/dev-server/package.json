{
  "name": "dev-server",
  "version": "0.0.0",
  "private": true,
  "description": "Local Vendure server that registers every plugin in this repo",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node --project tsconfig.json src/index.ts",
    "dashboard": "vite --config vite.config.mts",
    "dashboard:build": "vite build --config vite.config.mts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests in dev-server\" && exit 0"
  },
  "dependencies": {
    "@uplab/vendure-plugin-nova-poshta": "workspace:*",
    "@uplab/vendure-plugin-turbosms": "workspace:*",
    "@vendure/asset-server-plugin": "3.8.0",
    "@vendure/core": "3.8.0",
    "@vendure/dashboard": "3.8.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/graphql": "14.0.3",
    "@types/node": "22.20.1",
    "currency-codes": "2.2.0",
    "graphql-tag": "2.12.7",
    "pg": "8.23.1",
    "ts-node": "10.9.2",
    "typeorm": "0.3.31",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
