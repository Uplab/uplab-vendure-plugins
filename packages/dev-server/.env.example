# Copy to .env to exercise a plugin against a live vendor API.
# Without these the plugins stay in dry-run / stub mode.

APP_PORT=3000

# TurboSMS — https://turbosms.ua/
TURBOSMS_API_KEY=
TURBOSMS_SENDER=Vendure
# Set to false to actually send SMS. Anything else (or unset) means dry-run.
TURBOSMS_DRY_RUN=true

# Nova Poshta — https://developers.novaposhta.ua/ (business account → Settings → Security)
NOVA_POSHTA_API_KEY=

# Exchange rates: ecb | frankfurter | monobank | nbu. Unset keeps fixed rates.
EXCHANGE_RATE_SOURCE=

# Change history. Set to false to stop recording.
CHANGE_HISTORY_ENABLED=true

# Database: unset = SQLite (vendure.sqlite). DEV_DB=postgres runs on Postgres, which the change history
# needs for before → after values, e.g. with
#   docker run -d --name vendure-dev-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=vendure_dev -p 5433:5432 postgres:15
DEV_DB=
DEV_DB_URL=postgres://postgres:postgres@localhost:5433/vendure_dev
