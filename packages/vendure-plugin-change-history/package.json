{
  "name": "@uplab/vendure-plugin-change-history",
  "version": "0.0.0",
  "description": "Change history for the Vendure catalogue: who changed what and when, with before → after values, batches, external sync runs and tiered retention",
  "license": "MIT",
  "author": "Uplab",
  "homepage": "https://github.com/Uplab/uplab-vendure-plugins/tree/main/packages/vendure-plugin-change-history#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uplab/uplab-vendure-plugins.git",
    "directory": "packages/vendure-plugin-change-history"
  },
  "bugs": {
    "url": "https://github.com/Uplab/uplab-vendure-plugins/issues"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "change-history",
    "history",
    "catalogue",
    "diff"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dashboard": "./dist/dashboard/public.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node ../../scripts/copy-dashboard.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ../../scripts/typecheck-dashboard.mjs",
    "test": "vitest run",
    "test:e2e:pg": "node -e \"process.env.CHANGE_HISTORY_E2E_PG_URL || (console.error('Set CHANGE_HISTORY_E2E_PG_URL, see TESTING.md'), process.exit(1))\" && vitest run e2e/change-history-postgres.e2e-spec.ts"
  },
  "dependencies": {
    "graphql-tag": "^2.12.6"
  },
  "peerDependencies": {
    "@lingui/react": "^5.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@vendure/core": "^3.7.0",
    "@vendure/dashboard": "^3.7.0",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "typeorm": "^0.3.21"
  },
  "peerDependenciesMeta": {
    "@lingui/react": {
      "optional": true
    },
    "@vendure/dashboard": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lingui/react": "^5.9.5",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.2.1",
    "@nestjs/graphql": "^13.0.0",
    "@types/react": "^19.0.0",
    "@vendure/core": "3.7.2",
    "@vendure/dashboard": "3.7.2",
    "@vendure/testing": "3.7.2",
    "graphql": "^16.11.0",
    "lucide-react": "^0.475.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.21",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
