{
  "name": "@uplab/vendure-plugin-unified-slug",
  "version": "0.2.2",
  "description": "Vendure plugin that keeps one slug per product and collection, identical in every language — on the server and in the dashboard",
  "license": "MIT",
  "author": "Uplab",
  "homepage": "https://github.com/Uplab/uplab-vendure-plugins/tree/main/packages/vendure-plugin-unified-slug#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uplab/uplab-vendure-plugins.git",
    "directory": "packages/vendure-plugin-unified-slug"
  },
  "bugs": {
    "url": "https://github.com/Uplab/uplab-vendure-plugins/issues"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "slug",
    "i18n",
    "translations",
    "dashboard"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node ../../scripts/copy-dashboard.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ../../scripts/typecheck-dashboard.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "graphql-tag": "^2.12.6"
  },
  "peerDependencies": {
    "@lingui/react": "^5.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/graphql": "^13.0.0 || ^14.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@vendure/core": "^3.7.0",
    "@vendure/dashboard": "^3.7.0",
    "lucide-react": ">=0.475.0",
    "react": "^19.0.0",
    "react-hook-form": "^7.71.0"
  },
  "peerDependenciesMeta": {
    "@lingui/react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@vendure/dashboard": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lingui/react": "5.9.5",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/graphql": "14.0.3",
    "@tanstack/react-query": "5.102.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vendure/core": "3.8.0",
    "@vendure/dashboard": "3.8.0",
    "@vendure/testing": "3.8.0",
    "jsdom": "26.1.0",
    "lucide-react": "0.475.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.86.0",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
