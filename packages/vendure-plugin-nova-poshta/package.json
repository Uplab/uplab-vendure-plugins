{
  "name": "@uplab/vendure-plugin-nova-poshta",
  "version": "0.1.1",
  "description": "Vendure plugin for Nova Poshta: city and warehouse lookups for checkout, in Ukraine and abroad",
  "license": "MIT",
  "author": "Uplab",
  "homepage": "https://github.com/Uplab/uplab-vendure-plugins/tree/main/packages/vendure-plugin-nova-poshta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uplab/uplab-vendure-plugins.git",
    "directory": "packages/vendure-plugin-nova-poshta"
  },
  "bugs": {
    "url": "https://github.com/Uplab/uplab-vendure-plugins/issues"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "nova-poshta",
    "novaposhta",
    "shipping",
    "ukraine"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "graphql-tag": "^2.12.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@vendure/core": "^3.7.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.2.1",
    "@nestjs/graphql": "^13.0.0",
    "@vendure/core": "3.7.2",
    "@vendure/testing": "3.7.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
