{
  "name": "@uplab/vendure-plugin-currency-exchange-rate",
  "version": "0.0.0",
  "description": "Vendure plugin for exchange rates against the hryvnia from Monobank, the NBU or your own source, with per-currency overrides in the dashboard",
  "license": "MIT",
  "author": "Uplab",
  "homepage": "https://github.com/Uplab/uplab-vendure-plugins/tree/main/packages/vendure-plugin-currency-exchange-rate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uplab/uplab-vendure-plugins.git",
    "directory": "packages/vendure-plugin-currency-exchange-rate"
  },
  "bugs": {
    "url": "https://github.com/Uplab/uplab-vendure-plugins/issues"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "currency",
    "exchange-rate",
    "monobank",
    "nbu",
    "ukraine"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node ../../scripts/copy-dashboard.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ../../scripts/typecheck-dashboard.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "currency-codes": "^2.2.0",
    "graphql-tag": "^2.12.6"
  },
  "peerDependencies": {
    "@lingui/react": "^5.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@vendure/core": "^3.7.0",
    "@vendure/dashboard": "^3.7.0",
    "graphql": "^16.0.0",
    "react": "^19.0.0",
    "typeorm": "^0.3.21"
  },
  "peerDependenciesMeta": {
    "@lingui/react": {
      "optional": true
    },
    "@vendure/dashboard": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lingui/react": "^5.9.5",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.2.1",
    "@nestjs/graphql": "^13.0.0",
    "@types/react": "^19.0.0",
    "@vendure/core": "3.7.2",
    "@vendure/dashboard": "3.7.2",
    "@vendure/testing": "3.7.2",
    "graphql": "^16.11.0",
    "react": "^19.0.0",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.21",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
