{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", ".claude/hooks/*.mjs"],
      "project": ["scripts/**", ".claude/hooks/**"],
      "ignoreDependencies": [
        "@arethetypeswrong/cli",
        "publint",
        "rimraf",
        "ts-node",
        "@swc/core",
        "unplugin-swc",
        "sql.js",
        "@vendure/core",
        "@vendure/testing"
      ]
    },
    "packages/vendure-plugin-*": {
      "entry": ["src/index.ts", "e2e/**/*.e2e-spec.ts"],
      "project": ["src/**", "e2e/**"]
    },
    "packages/vendure-plugin-unified-slug": {
      "entry": ["src/index.ts", "src/dashboard/index.tsx", "e2e/**/*.e2e-spec.ts"],
      "project": ["src/**", "e2e/**"]
    },
    "packages/dev-server": {
      "ignoreDependencies": ["better-sqlite3", "@nestjs/graphql", "graphql-tag", "currency-codes", "typeorm"]
    },
    "packages/vendure-plugin-currency-exchange-rate": {
      "entry": ["src/index.ts", "src/dashboard/index.tsx", "e2e/**/*.e2e-spec.ts"],
      "project": ["src/**", "e2e/**"]
    }
  }
}
